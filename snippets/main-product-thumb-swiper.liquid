<div
  dir="ltr"
  class="swiper tf-product-media-thumbs other-image-zoom {{ classes }}"
  data-direction="{{ direction }}"
  data-preview="{{ preview }}"
  data-space="{{ space }}"
>
  <div class="swiper-wrapper stagger-wrap">
    {% for media in product.media %}
      <div class="swiper-slide stagger-item">
        <div class="item {% if media.media_type == 'video' or media.media_type == 'external_video' or media.media_type == 'model' %}wrap-btn-viewer{% endif %}">
          {% if media.media_type == 'video' or media.media_type == 'external_video' %}
            <i class="icon icon-video"></i>
          {% elsif media.media_type == 'model' %}
            <span class="icon icon-3d-model-thumb">
              <i class="icon icon-view"></i>
            </span>
          {% endif %}
          <img
            class="lazyload"
            data-src="{{ media.preview_image | image_url }}"
            src="{{ media.preview_image | image_url }}"
            alt="{{ media.alt | escape }}"
            width="{{ media.preview_image.width }}"
            height="{{ media.preview_image.height }}"
          >
        </div>
      </div>
    {% endfor %}
  </div>
  {% if product.media.size > 1 %}
    <div class="tf-sw-nav tf-sw-nav-thumb nav-prev-thumbs">
      {% if direction == 'vertical' %}
        <i class="icon icon-caret-up"></i>
      {% else %}
        <i class="icon icon-caret-left"></i>
      {% endif %}
    </div>
    <div class="tf-sw-nav tf-sw-nav-thumb nav-next-thumbs">
      {% if direction == 'vertical' %}
        <i class="icon icon-caret-down"></i>
      {% else %}
        <i class="icon icon-caret-right"></i>
      {% endif %}
    </div>
  {% endif %}
</div>
